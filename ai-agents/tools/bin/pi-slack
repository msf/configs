#!/usr/bin/env python3
"""Small Slack Web API CLI for pi. Uses only the stdlib."""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

TOKEN_CANDIDATES = [
    ("SLACK_USER_TOKEN", os.environ.get("SLACK_USER_TOKEN")),
    ("SLACK_BOT_TOKEN", os.environ.get("SLACK_BOT_TOKEN")),
    ("SLACK_TOKEN", os.environ.get("SLACK_TOKEN")),
]
TOKEN_FILES = [
    os.environ.get("SLACK_TOKEN_FILE"),
    os.path.expanduser("~/.config/pi-workspace/slack.token"),
]


def die(message: str, code: int = 1) -> None:
    print(f"pi-slack: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_token() -> tuple[str, str]:
    for source, value in TOKEN_CANDIDATES:
        if value:
            return value.strip(), source
    for path in TOKEN_FILES:
        if not path:
            continue
        path = os.path.expanduser(path)
        if os.path.exists(path):
            with open(path, "r", encoding="utf-8") as f:
                value = f.read().strip()
            if value:
                return value, path
    die(
        "missing token. Set SLACK_USER_TOKEN/SLACK_BOT_TOKEN or create "
        "~/.config/pi-workspace/slack.token. Prefer a least-privilege user token for search.messages; "
        "a bot token works for channels it is in."
    )


def slack_api(method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
    token, _ = read_token()
    params = {k: v for k, v in (params or {}).items() if v is not None}
    url = f"https://slack.com/api/{method}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")
        die(f"Slack API HTTP {e.code} for {method}: {detail}")
    except urllib.error.URLError as e:
        die(f"Slack API request failed: {e}")
    if not data.get("ok"):
        die(f"Slack API {method} failed: {data.get('error', data)}")
    return data


def clean_text(text: str | None) -> str:
    return " ".join((text or "").replace("\t", " ").split())


def ts_to_iso(ts: str | None) -> str:
    if not ts:
        return ""
    try:
        return dt.datetime.fromtimestamp(float(ts), tz=dt.timezone.utc).isoformat()
    except ValueError:
        return ts


def iter_channels(types: str, limit: int | None = None):
    cursor = None
    seen = 0
    while True:
        page_size = min(1000, limit - seen) if limit else 1000
        res = slack_api("conversations.list", {"types": types, "limit": page_size, "cursor": cursor, "exclude_archived": False})
        for ch in res.get("channels", []):
            yield ch
            seen += 1
            if limit and seen >= limit:
                return
        cursor = res.get("response_metadata", {}).get("next_cursor")
        if not cursor:
            return
        time.sleep(0.2)


def resolve_channel(value: str, types: str = "public_channel,private_channel,im,mpim") -> str:
    raw = value.strip()
    if raw.startswith(("C", "G", "D")) and " " not in raw:
        return raw
    name = raw.lstrip("#").lower()
    for ch in iter_channels(types):
        if (ch.get("name") or "").lower() == name:
            return ch["id"]
    die(f"channel not found: {value}. Use pi-slack channels --query {name!r} or pass a channel ID.")


def cmd_status(args: argparse.Namespace) -> None:
    token, source = read_token()
    print(f"token: {source} ({len(token)} bytes, prefix {token[:4]}…)")
    if args.check:
        print(json.dumps(slack_api("auth.test"), indent=2))


def cmd_channels(args: argparse.Namespace) -> None:
    rows = list(iter_channels(args.types, args.limit))
    if args.query:
        q = args.query.lower()
        rows = [ch for ch in rows if q in (ch.get("name") or "").lower() or q in (ch.get("topic", {}).get("value") or "").lower()]
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    for ch in rows[: args.limit]:
        prefix = "#" if not ch.get("is_im") else "@"
        topic = clean_text(ch.get("topic", {}).get("value"))
        flags = []
        if ch.get("is_private"):
            flags.append("private")
        if ch.get("is_archived"):
            flags.append("archived")
        print(f"{ch.get('id')}\t{prefix}{ch.get('name', ch.get('user', 'dm'))}\t{','.join(flags) or '-'}\t{topic}")


def cmd_search(args: argparse.Namespace) -> None:
    # Requires a user token with search:read in most Slack workspaces.
    res = slack_api("search.messages", {"query": args.query, "count": args.limit, "sort": "timestamp", "sort_dir": "desc"})
    matches = res.get("messages", {}).get("matches", [])
    if args.json:
        print(json.dumps(matches, indent=2))
        return
    for m in matches:
        channel = m.get("channel", {}).get("name") or m.get("channel", {}).get("id", "")
        user = m.get("username") or m.get("user") or ""
        print(f"{ts_to_iso(m.get('ts'))}\t#{channel}\t{user}\t{m.get('permalink', '')}\t{clean_text(m.get('text'))}")


def cmd_history(args: argparse.Namespace) -> None:
    channel_id = resolve_channel(args.channel, args.types)
    res = slack_api("conversations.history", {
        "channel": channel_id,
        "limit": args.limit,
        "oldest": args.oldest,
        "latest": args.latest,
        "inclusive": args.inclusive,
    })
    messages = res.get("messages", [])
    if args.json:
        print(json.dumps(messages, indent=2))
        return
    for m in messages:
        user = m.get("user") or m.get("bot_id") or m.get("username") or ""
        reply = f" replies={m.get('reply_count')}" if m.get("reply_count") else ""
        print(f"{m.get('ts')}\t{ts_to_iso(m.get('ts'))}\t{user}{reply}\t{clean_text(m.get('text'))}")


def cmd_thread(args: argparse.Namespace) -> None:
    channel_id = resolve_channel(args.channel, args.types)
    res = slack_api("conversations.replies", {"channel": channel_id, "ts": args.ts, "limit": args.limit})
    messages = res.get("messages", [])
    if args.json:
        print(json.dumps(messages, indent=2))
        return
    for m in messages:
        user = m.get("user") or m.get("bot_id") or m.get("username") or ""
        print(f"{m.get('ts')}\t{ts_to_iso(m.get('ts'))}\t{user}\t{clean_text(m.get('text'))}")


def cmd_users(args: argparse.Namespace) -> None:
    cursor = None
    users: list[dict[str, Any]] = []
    while len(users) < args.limit:
        res = slack_api("users.list", {"limit": min(200, args.limit - len(users)), "cursor": cursor})
        users.extend(res.get("members", []))
        cursor = res.get("response_metadata", {}).get("next_cursor")
        if not cursor:
            break
    if args.query:
        q = args.query.lower()
        users = [u for u in users if q in (u.get("name") or "").lower() or q in (u.get("real_name") or "").lower() or q in (u.get("profile", {}).get("email") or "").lower()]
    if args.json:
        print(json.dumps(users, indent=2))
        return
    for u in users[: args.limit]:
        prof = u.get("profile", {})
        print(f"{u.get('id')}\t{u.get('name')}\t{u.get('real_name')}\t{prof.get('email', '')}\t{'deleted' if u.get('deleted') else ''}")


def cmd_user(args: argparse.Namespace) -> None:
    if "@" in args.user:
        res = slack_api("users.lookupByEmail", {"email": args.user})
        user = res.get("user", {})
    else:
        res = slack_api("users.info", {"user": args.user})
        user = res.get("user", {})
    print(json.dumps(user, indent=2))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Slack Web API CLI for pi (search, channels, history, threads, users).")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="Show token source; use --check to call auth.test")
    s.add_argument("--check", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("channels", help="List channels/DMs visible to the token")
    s.add_argument("--types", default="public_channel,private_channel", help="Slack conversation types")
    s.add_argument("--query")
    s.add_argument("--limit", type=int, default=200)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_channels)

    s = sub.add_parser("search", help="Search Slack messages (usually requires user token + search:read)")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_search)

    s = sub.add_parser("history", help="Read recent channel history")
    s.add_argument("channel", help="#name or channel ID")
    s.add_argument("--types", default="public_channel,private_channel,im,mpim")
    s.add_argument("--limit", type=int, default=50)
    s.add_argument("--oldest")
    s.add_argument("--latest")
    s.add_argument("--inclusive", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_history)

    s = sub.add_parser("thread", help="Read a message thread")
    s.add_argument("channel", help="#name or channel ID")
    s.add_argument("ts", help="root message timestamp")
    s.add_argument("--types", default="public_channel,private_channel,im,mpim")
    s.add_argument("--limit", type=int, default=100)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_thread)

    s = sub.add_parser("users", help="List/search users")
    s.add_argument("--query")
    s.add_argument("--limit", type=int, default=200)
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_users)

    s = sub.add_parser("user", help="Get one user by ID or email")
    s.add_argument("user")
    s.set_defaults(func=cmd_user)
    return p


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
