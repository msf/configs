autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '✚'
zstyle ':vcs_info:git:*' unstagedstr '±'
zstyle ':vcs_info:git:*' formats '  %F{magenta} %b%f %F{yellow}%u%c%f'
zstyle ':vcs_info:git:*' actionformats '  %F{magenta} %b|%a%f %F{yellow}%u%c%f'

setopt prompt_subst
precmd() {
  local exit_code=$?
  vcs_info
  (( exit_code )) && prompt_end='%F{red}%f' || prompt_end='%F{green}%f'
}

PROMPT='%F{blue}%n@%m%f  %F{cyan}%~%f${vcs_info_msg_0_} $prompt_end '
