[Unit]
Description=llama.cpp FIM server (Qwen2.5-Coder-3B Q4_K_M)
After=local-fs.target

[Service]
Type=simple
ExecStart=%h/bin/llama-server \
    --model %h/play/llama/models/Qwen2.5-Coder-3B/Qwen2.5-Coder-3B-Q4_K_M.gguf \
    --ctx-size 0 --batch-size 1024 --ubatch-size 1024 --cache-reuse 256 \
    --port 8012 --no-webui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
