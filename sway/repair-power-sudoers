#!/usr/bin/env bash
set -euo pipefail

(( EUID == 0 && $# == 0 )) || { printf 'Usage: sudo bash %s\n' "$0" >&2; exit 1; }
target=/etc/sudoers.d/fw13-power
read -r present < /sys/devices/system/cpu/present
[[ $present == 0-23 ]] || { printf 'Unexpected CPU topology: %s\n' "$present" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp -p "$target" "$work/original"
while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in
        *'/usr/bin/tee /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference'|\
        *'/usr/bin/tee /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq')
            # Include offline CPUs: their policies may be absent until brought online.
            for ((cpu=0; cpu<24; cpu++)); do
                printf '%s\n' "${line/'policy*'/policy$cpu}"
            done
            ;;
        *) printf '%s\n' "$line" ;;
    esac
done < "$work/original" > "$work/repaired"
visudo -cf "$work/repaired"
if cmp -s "$work/original" "$work/repaired"; then
    printf 'No wildcard rules to repair.\n'
    exit 0
fi
cmp -s "$work/original" "$target" || { printf 'Sudoers changed during repair; retry.\n' >&2; exit 1; }
backup=$(mktemp /var/backups/fw13-power.XXXXXX)
cp -p "$work/original" "$backup"
install -o root -g root -m 0440 "$work/repaired" "$target"
visudo -cf "$target"
printf 'Repaired %s. Original saved to %s.\n' "$target" "$backup"
